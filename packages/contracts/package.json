{
  "name": "@kolo/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned exchange envelopes and runtime validation",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "react-native": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
