---
/** Line icons drawn on a 24px grid, plus the filled GitHub mark. Decorative: hidden from assistive technology. */
interface Props {
  name: 'sell' | 'stock' | 'report' | 'windows' | 'linux' | 'android' | 'arrow' | 'guide' | 'slides' | 'github';
}
const paths = {
  sell: '<path d="M4 5h16v14H4zM4 9h16M8 13h3m-3 3h6"/>',
  stock: '<path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 9v10M3 8l9 4 9-4M7.5 5.5l9 5"/>',
  report: '<path d="M4 3v18h17M8 16v-5m5 5V6m5 10v-8"/>',
  windows: '<path d="m3 5 8-1v7H3V5Zm10-1 8-1v8h-8V4ZM3 13h8v7l-8-1v-6Zm10 0h8v8l-8-1v-7Z"/>',
  linux: '<path d="M4 4h16v13H4zM2 21h20M8 8l3 3-3 3m5 0h3"/>',
  android: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 5h4m-3 14h2"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  guide: '<path d="M6 3h9l4 4v14H6zM15 3v4h4M9 12h7m-7 4h5"/>',
  slides: '<path d="M3 4h18v12H3zM12 16v4m-4 0h8M7 12l3-3 2 2 4-4"/>',
};
const github = '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>';
const { name } = Astro.props;
---
{name === 'github'
  ? <svg class="icon github-mark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={github} />
  : <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />}
