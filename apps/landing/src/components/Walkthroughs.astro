---
/**
 * First-user walkthrough videos: a self-hosted thumbnail that swaps in the YouTube player
 * (youtube-nocookie.com) only when pressed, so nothing loads from YouTube before play. Without
 * JavaScript the thumbnail links to YouTube. Falls back to the other language's video until this
 * one is uploaded.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { href, translations, walkthrough, walkthroughPlatforms, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
const thumbnails = import.meta.glob<{ default: ImageMetadata }>('../images/walkthrough-*.jpg');
const videos = (await Promise.all(walkthroughPlatforms.map(async platform => {
  const video = walkthrough(lang, platform);
  if (!video) return null;
  const load = thumbnails[`../images/walkthrough-${platform}-${video.lang}.jpg`];
  if (!load) throw new Error(`No src/images/walkthrough-${platform}-${video.lang}.jpg`);
  const image = (await load()).default;
  const variants = await Promise.all([480, 800].map(async width => `${(await getImage({ src: image, width, format: 'webp' })).src} ${width}w`));
  return { platform, ...video, title: t.walkthroughs[platform], image, srcset: variants.join(', '), fallback: variants[0].split(' ')[0] };
}))).filter(video => video !== null);
---
{videos.length > 0 && <div class="walkthroughs"><h3>{t.walkthroughsTitle}</h3><p>{t.walkthroughsLead}</p><div class="download-grid resource-grid">{videos.map(video => <article class="download-card walkthrough-card"><div class="walkthrough-player"><a class="walkthrough-thumb" href={video.url} data-embed={video.embed} data-title={video.title} aria-label={t.walkthroughsPlay.replace('{title}', video.title)}><img src={video.fallback} srcset={video.srcset} sizes="(max-width: 760px) calc(100vw - 92px), 520px" alt="" width={video.image.width} height={video.image.height} loading="lazy" decoding="async"><span class="walkthrough-play" aria-hidden="true"></span></a></div><h4>{video.title}</h4><small>{t.walkthroughsMeta}{video.lang !== lang && ` · ${t.walkthroughsOtherLanguage}`}</small><div class="inline-links"><a href={video.url}>{t.walkthroughsOpen} ↗</a></div></article>)}</div><p class="hint walkthrough-note">{t.walkthroughsNote} <a href={href(`${lang}/privacy/`)}>{t.policies.privacyLink}</a></p></div>}
<script src="../scripts/walkthroughs.js"></script>
