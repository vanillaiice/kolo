{
  "expo": {
    "name": "KOLO",
    "slug": "kolo",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "kolo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "cm.kolo.app"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KOLO uses your photos only to add a product picture you choose.",
          "cameraPermission": "KOLO uses the camera only to take a product picture.",
          "microphonePermission": false
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
