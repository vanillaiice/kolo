{
  "expo": {
    "name": "KOLO",
    "slug": "kolo",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kolo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "cm.kolo.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0c3426"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KOLO uses your photos only to add a product picture you choose.",
          "cameraPermission": "KOLO uses the camera only to take a product picture.",
          "microphonePermission": false
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0c3426",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0c3426"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "kolo uses the camera to scan the code shown on your shop's main till.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/monochrome-icon.png",
          "color": "#0c3426"
        }
      ],
      "./plugins/with-abi-splits.js",
      "./plugins/with-lan-http.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
