{
  "name": "@kolo/mobile",
  "version": "0.1.2",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "KOLO mobile client — React Native, Android first",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "bundle": "expo export --platform android --output-dir .expo/export",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@kolo/contracts": "0.1.0",
    "@kolo/core": "0.1.0",
    "expo": "^57.0.15",
    "expo-constants": "~57.0.13",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "^57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "main": "index.ts"
}
