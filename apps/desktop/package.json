{
  "name": "@kolo/desktop",
  "version": "0.12.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Standalone Electron till with a local SQLite database",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "node scripts/test-in-electron.mjs \"src/electron/*.test.ts\" \"src/renderer/*.test.ts\"",
    "dev": "npm run build && electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@kolo/contracts": "0.1.0",
    "@kolo/core": "0.1.0",
    "electron-updater": "6.8.9",
    "hash-wasm": "4.12.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.1.1",
    "@types/react-dom": "^19.1.0",
    "@types/semver": "7.7.1",
    "axe-core": "4.14.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.0",
    "vite": "8.3.5"
  }
}
