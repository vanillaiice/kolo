{
  "appId": "com.hblabs.kolo",
  "productName": "KOLO",
  "directories": {
    "app": ".packaging/desktop",
    "output": "release/desktop",
    "buildResources": "apps/desktop/build"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!**/*.map"
  ],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "KOLO-${version}-${os}-${arch}.${ext}",
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "apps/desktop/build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "artifactName": "KOLO-${version}-win-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "KOLO-${version}-win-${arch}-portable.${ext}"
  },
  "appx": {
    "identityName": "hblabs.KOLO",
    "applicationId": "KOLO",
    "displayName": "KOLO",
    "publisherDisplayName": "hblabs",
    "backgroundColor": "#0C3426",
    "languages": [
      "fr-FR",
      "en-US"
    ],
    "showNameOnTiles": false,
    "artifactName": "KOLO-${version}-win-${arch}-store.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "executableName": "kolo",
    "category": "Office",
    "synopsis": "Offline shop management: sales, stock, credit and reports",
    "maintainer": "hblabs <vanillaiice@tutanota.com>",
    "icon": "apps/desktop/build/icon.png"
  }
}
