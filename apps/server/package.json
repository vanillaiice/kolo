{
  "name": "@kolo/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Optional synchronization server; shared by hosted and self-hosted editions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@kolo/contracts": "0.1.0",
    "@kolo/core": "0.1.0",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
