{
  "name": "@kolo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional synchronization server; shared by hosted and self-hosted editions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@kolo/contracts": "0.1.0",
    "@kolo/core": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": { "@types/pg": "8.23.1" }
}
