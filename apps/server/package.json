{
  "name": "@kolo/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Optional synchronization server; shared by hosted and self-hosted editions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "migrate": "node --env-file-if-exists=.env dist/main.js migrate"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@kolo/contracts": "0.1.0",
    "@kolo/core": "0.1.0",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6"
  }
}
