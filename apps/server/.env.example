KOLO_HOST=127.0.0.1
PORT=8080
# Sync needs PostgreSQL; run `npm run migrate -w @kolo/server` before starting. /readyz returns 503 until then.
DATABASE_URL=postgres://kolo:kolo@localhost:5433/kolo?sslmode=disable
# The address tills use to reach this server, printed into connection codes. Defaults to http://127.0.0.1:<PORT>
# when listening on loopback; set it for a LAN or public deployment. Issue a code per shop with
# `node dist/main.js invite --label "Shop name"` or from the operator dashboard.
KOLO_PUBLIC_URL=
# Operator dashboard listener (loopback by default; `off` disables it). Create an operator with
# `node dist/main.js admin create <username>`, then open http://127.0.0.1:8081/admin/
KOLO_ADMIN_HOST=127.0.0.1
KOLO_ADMIN_PORT=8081
# on (default): password + authenticator code. off: password only, allowed only while KOLO_ADMIN_HOST is loopback.
KOLO_ADMIN_TOTP=on
# The server's Ed25519 identity, created on first start. Keep it and back it up.
KOLO_SERVER_KEY_FILE=.kolo-server-key.json
KOLO_SESSION_TTL_SECONDS=3600
# true only behind a reverse proxy you control, so rate limits see client addresses.
KOLO_TRUST_PROXY=false
# fatal, error, warn, info (default), debug, trace or silent
KOLO_LOG_LEVEL=info
